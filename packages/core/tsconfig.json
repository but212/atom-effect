{
  "extends": "@but212/atom-effect-configs/tsconfig",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@tests/*": ["./__tests__/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "./dist",
    "types": ["node"],
    "noImplicitAny": true
  },
  "include": ["src/**/*", "__tests__/**/*", "__benchmarks__/**/*.bench.ts", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
