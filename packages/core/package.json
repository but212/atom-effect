{
  "name": "@but212/atom-effect",
  "version": "0.32.1",
  "type": "module",
  "description": "A reactive state management library that combines the power of `atom`, `computed`, and `effect` for seamless management of reactive state.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/atom-effect.min.js",
  "jsdelivr": "./dist/atom-effect.min.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:types && pnpm run build:lib && pnpm run build:bundle",
    "build:types": "cross-env BUILD_TARGET=types vite build",
    "build:lib": "cross-env BUILD_TARGET=lib vite build",
    "build:bundle": "cross-env BUILD_TARGET=bundle vite build",
    "clean": "rimraf dist",

    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest __tests__/unit",
    "test:integration": "vitest __tests__/integration",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepublishOnly": "pnpm run build",
    "bench": "vitest bench --config vitest.bench.config.ts",
    "bench:micro": "pnpm run bench __benchmarks__/micro",
    "bench:macro": "pnpm run bench __benchmarks__/macro",
    "bench:state": "pnpm run bench __benchmarks__/state",
    "bench:realistic": "pnpm run bench __benchmarks__/realistic",
    "bench:scheduler": "pnpm run bench __benchmarks__/micro/scheduler.bench.ts",
    "bench:all": "pnpm run bench"
  },
  "keywords": [
    "reactive",
    "atom",
    "computed",
    "effect",
    "atom-effect",
    "signal",
    "reactive-signal"
  ],
  "author": "Jeongil Suk",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/but212/atom-effect.git",
    "directory": "packages/core"
  },
  "devDependencies": {
    "@but212/atom-effect-configs": "workspace:*",
    "@but212/atom-effect-utils": "workspace:*",
    "@types/node": "^25.6.2",
    "@vitest/browser": "^4.1.5",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "playwright": "^1.59.1",
    "tinybench": "^6.0.1",
    "vite": "^8.0.11",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.5"
  }
}
