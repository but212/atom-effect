{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2021",
    "paths": {
      "@/*": ["./src/*"]
    },
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "noImplicitAny": true
  },
  "include": ["src/**/*.ts", "__tests__/**/*.ts", "__benchmarks__/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
