{
  "name": "@but212/atom-effect-jquery",
  "version": "0.33.0",
  "description": "Reactive jQuery bindings powered by atom-effect",
  "keywords": [
    "jquery",
    "reactivity",
    "atom",
    "signals",
    "state-management",
    "binding",
    "plugin",
    "observer"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/atom-effect-jquery.min.js",
  "jsdelivr": "./dist/atom-effect-jquery.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:types && pnpm run build:lib && pnpm run build:bundle",
    "build:types": "cross-env BUILD_TARGET=types vite build",
    "build:lib": "cross-env BUILD_TARGET=lib vite build",
    "build:bundle": "cross-env BUILD_TARGET=bundle vite build",
    "clean": "rimraf dist",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "bench": "vitest bench --config vitest.bench.config.ts",
    "bench:micro": "pnpm run bench __benchmarks__/micro",
    "bench:macro": "pnpm run bench __benchmarks__/macro",
    "prepublishOnly": "pnpm run build"
  },
  "author": "but212",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/but212/atom-effect.git",
    "directory": "packages/jquery"
  },
  "peerDependencies": {
    "jquery": ">=4.0.0"
  },
  "dependencies": {
    "@but212/atom-effect": "workspace:*"
  },
  "devDependencies": {
    "@but212/atom-effect-configs": "workspace:*",
    "@but212/atom-effect-utils": "workspace:*",
    "@types/jquery": "^4.0.0",
    "@vitest/browser": "^4.1.6",
    "@vitest/browser-playwright": "^4.1.6",
    "@vitest/coverage-v8": "^4.1.6",
    "jquery": "^4.0.0",
    "playwright": "^1.60.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
