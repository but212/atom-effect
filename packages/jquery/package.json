{
  "name": "@but212/atom-effect-jquery",
  "version": "0.24.0",
  "description": "Reactive jQuery bindings powered by atom-effect",
  "keywords": [
    "jquery",
    "reactivity",
    "atom",
    "signals",
    "state-management",
    "binding",
    "plugin",
    "observer"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/atom-effect-jquery.min.js",
  "jsdelivr": "./dist/atom-effect-jquery.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "clean": "rimraf dist",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "bench": "vitest bench --config vitest.bench.config.ts",
    "bench:micro": "pnpm run bench __benchmarks__/micro",
    "bench:macro": "pnpm run bench __benchmarks__/macro",
    "prepublishOnly": "pnpm run build"
  },
  "author": "but212",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/but212/atom-effect.git",
    "directory": "packages/jquery"
  },
  "peerDependencies": {
    "jquery": ">=3.0.0"
  },
  "dependencies": {
    "@but212/atom-effect": "workspace:*"
  },
  "devDependencies": {
    "@types/jquery": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.1",
    "jquery": "^4.0.0",
    "jsdom": "^29.0.1",
    "vite": "^8.0.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.1"
  }
}
