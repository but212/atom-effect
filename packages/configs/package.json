{
  "name": "@but212/atom-effect-configs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tsconfig": "./tsconfig.base.json"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean:build": "rimraf dist",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "unplugin-dts": "^1.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "devDependencies": {
    "rimraf": "catalog:",
    "unplugin-dts": "catalog:build",
    "vite": "catalog:build",
    "vitest": "catalog:test"
  },
  "dependencies": {},
  "optionalDependencies": {}
}