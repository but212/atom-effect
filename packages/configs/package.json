{
  "name": "@but212/atom-effect-configs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js",
      "require": "./dist/vitest.cjs"
    },
    "./vitest.bench": {
      "types": "./dist/vitest.bench.d.ts",
      "import": "./dist/vitest.bench.js",
      "require": "./dist/vitest.bench.cjs"
    },
    "./tsup": {
      "types": "./dist/tsup.d.ts",
      "import": "./dist/tsup.js",
      "require": "./dist/tsup.cjs"
    },
    "./tsconfig": "./tsconfig.base.json"
  },
  "scripts": {
    "build": "tsup src/index.ts src/vite.ts src/vitest.ts src/vitest.bench.ts src/tsup.ts --format esm,cjs --dts --clean --tsconfig tsconfig.build.json --external unplugin-dts --external @vue/language-core",
    "dev": "pnpm run build --watch"
  },
  "peerDependencies": {
    "tsup": "^8.5.1",
    "vite": "^8.0.0",
    "unplugin-dts": "^1.0.0",
    "vitest": "^4.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "unplugin-dts": "^1.0.0",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
