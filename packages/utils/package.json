{
  "name": "@but212/atom-effect-utils",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "pnpm run build:types && pnpm run build:lib && pnpm run build:bundle",
    "build:types": "cross-env BUILD_TARGET=types vite build",
    "build:lib": "cross-env BUILD_TARGET=lib vite build",
    "build:bundle": "cross-env BUILD_TARGET=bundle vite build",
    "clean:build": "rimraf dist",
    "dev": "vite",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --config vitest.bench.config.ts",
    "bench:all": "pnpm run bench",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@but212/atom-effect-configs": "workspace:*",
    "rimraf": "catalog:",
    "vite": "catalog:build",
    "vitest": "catalog:test",
    "typescript": "catalog:build",
    "cross-env": "catalog:build",
    "tinybench": "catalog:test"
  }
}
