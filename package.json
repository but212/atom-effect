{
  "name": "atom-effect-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for atom-effect reactive state management library and its ecosystem",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "bench": "turbo run bench",
    "clean": "turbo run clean && rimraf .turbo node_modules/.cache"
  },
  "keywords": [
    "reactive",
    "atom",
    "computed",
    "effect",
    "atom-effect",
    "signal",
    "monorepo"
  ],
  "author": "Jeongil Suk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/but212/atom-effect.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/node": "^25.6.2",
    "@vitest/browser-playwright": "^4.1.5",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "turbo": "^2.9.12",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0"
  }
}
