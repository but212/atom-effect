{
  "name": "atom-effect-monorepo",
  "version": "0.33.1",
  "private": true,
  "type": "module",
  "description": "Monorepo for atom-effect reactive state management library and its ecosystem",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "bench": "turbo run bench",
    "clean:build": "turbo run clean:build && rimraf .turbo node_modules/.cache"
  },
  "keywords": [
    "reactive",
    "atom",
    "computed",
    "effect",
    "atom-effect",
    "signal",
    "monorepo"
  ],
  "author": "Jeongil Suk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/but212/atom-effect.git"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@microsoft/api-extractor": "^7.58.9",
    "@types/node": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "cross-env": "catalog:",
    "playwright": "catalog:",
    "rimraf": "catalog:",
    "tinybench": "catalog:",
    "turbo": "^2.9.18",
    "typescript": "catalog:",
    "unplugin-dts": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22.0.0"
  }
}
