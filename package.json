{
  "name": "atom-effect-monorepo",
  "version": "0.33.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for atom-effect reactive state management library and its ecosystem",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "bench": "turbo run bench",
    "clean": "turbo run clean && rimraf .turbo node_modules/.cache"
  },
  "keywords": [
    "reactive",
    "atom",
    "computed",
    "effect",
    "atom-effect",
    "signal",
    "monorepo"
  ],
  "author": "Jeongil Suk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/but212/atom-effect.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@microsoft/api-extractor": "^7.58.7",
    "@types/node": "^25.9.1",
    "@vitest/browser-playwright": "^4.1.8",
    "cross-env": "^10.1.0",
    "playwright": "^1.60.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.22.4",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.0.0"
  }
}
