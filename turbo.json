{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": ["GITHUB_REF_NAME"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "test:run": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "lint": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "bench": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "clean:build": {
      "cache": false
    }
  }
}
